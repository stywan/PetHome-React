{
  "name": "pethome-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "karma start karma.conf.cjs",
    "test:single": "karma start karma.conf.cjs --single-run",
    "test:headless": "karma start karma.conf.cjs --browsers ChromeHeadlessCI --single-run",
    "test:coverage": "karma start karma.conf.cjs --single-run && open coverage/html/index.html",
    "test:coverage:report": "open coverage/html/index.html"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "babel-loader": "^10.0.0",
    "babel-plugin-istanbul": "^7.0.1",
    "css-loader": "^7.1.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "jasmine-core": "^5.12.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-spec-reporter": "^0.0.36",
    "karma-webpack": "^5.0.1",
    "style-loader": "^4.0.0",
    "vite": "^7.1.7",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
